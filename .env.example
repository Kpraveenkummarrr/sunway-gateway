# =============================================================================
# Synway SMG4004 GSM Gateway + Asterisk + AI Voice Agent — Environment Config
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:8000
APP_SECRET_KEY=

# --- Database ---
# PostgreSQL with pgvector extension enabled
DATABASE_URL=postgresql://sunway_user:CHANGE_ME@localhost:5432/sunway_gateway

# --- Asterisk (AMI / ARI connection from FastAPI backend) ---
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_PASSWORD=
ASTERISK_ARI_PORT=8088
# ARI user "ai-agent" — generate a real password with
# asterisk/scripts/generate_ari_secret.sh, never a default/blank one.
ASTERISK_ARI_USERNAME=ai-agent
ASTERISK_ARI_PASSWORD=
# Leave blank to construct http://<ASTERISK_HOST>:<ASTERISK_ARI_PORT>/ari
ASTERISK_ARI_URL=
ASTERISK_ARI_APP=ai-agent
# Where Asterisk writes ARI-triggered call recordings (must exist and be
# readable by whatever user runs app/ai_call_worker.py — deploy.sh creates
# it). Distinct from RECORDING_PATH below, which is Phase 3's MixMonitor
# call-recording directory.
ASTERISK_RECORDING_SPOOL_PATH=/var/spool/asterisk/recording

# --- AI phone call test path (Phase 6, no SMG4004 involved) ---
AI_TEST_EXTENSION=700
# Longest one call may last (0 = no limit). A polite closing message is played
# at the limit. It was 120 - which, checked only at turn boundaries and ending
# the call with no goodbye, cut real calls at ~2:45. If your .env still says
# 120, change it: a value copied from an older example overrides the new default.
AI_CALL_TIMEOUT_SECONDS=900
# Asterisk's own end-of-speech limits, kept as a BACKSTOP. Its silence detector
# only runs on voice frames, so a gateway that sends RTP comfort noise (payload
# type 13) during silence never trips it and every turn runs to
# AI_MAX_TURN_SECONDS. The worker-side detector below is what normally ends a turn.
AI_END_OF_SPEECH_SILENCE_SECONDS=2
AI_MAX_TURN_SECONDS=20
# Worker-side end-of-speech detection. Set AI_ENDPOINT_MONITOR=false only to fall
# back to Asterisk's detector alone. SILENCE_MS is dead air before every reply:
# lower answers sooner, higher tolerates longer pauses mid-sentence. It is judged
# from Asterisk's talk-detect events and, for gateways that stop sending voice
# frames when the caller is quiet, from the RTP receive counters
# (AI_ENDPOINT_USE_RTP_STATISTICS; needs ARI rtp_statistics, present in Asterisk 18).
AI_ENDPOINT_MONITOR=true
AI_ENDPOINT_SILENCE_MS=1200
AI_ENDPOINT_MIN_SPEECH_MS=250
AI_ENDPOINT_USE_RTP_STATISTICS=true
# Consecutive seconds with no caller speech before goodbye + hangup.
AI_NO_INPUT_TIMEOUT_SECONDS=20
# Barge-in sensitivity, applied to every AI call through ARI (no dialplan edit).
# THRESHOLD is the mean |sample| a frame needs to count as the caller talking
# (16-bit scale; NOT a duration). Lower = interrupts more easily. The old dialplan
# value of 500 never fired for soft-spoken callers (350 did not trigger). Set it to
# roughly 2.5x your line's noise level (scripts/audio_level_report.py shows it).
AI_TALK_DETECT_OVERRIDE=true
AI_TALK_DETECT_THRESHOLD=350
AI_TALK_DETECT_SILENCE_MS=200
# Speech tempo for synthesized replies, pitch preserved. 1.0 = NO processing at
# all (the samples are not touched); any other value runs the time-stretch stage.
# It was 1.15. On real speech that stage barely degraded quality (F0 jitter
# 1.83% -> 1.94%), but it is unnecessary work and makes replies sound rushed.
AI_TTS_SPEED=1.0
# Audio processing: "clean" (default) or "legacy" (the previous chain, for A/B).
AI_AUDIO_PROFILE=clean
AI_TTS_TARGET_RMS_DBFS=-18
AI_TTS_PEAK_CEILING_DBFS=-3
# Play Asterisk's record beep before each caller turn. Off by default: a beep
# every turn sounds like an answering machine. The turn after an interruption
# never beeps regardless of this setting.
AI_RECORD_BEEP=false
# Caller-facing phrases (welcome, provider-error, too-many-failed-turns
# goodbye). Leave these commented out to use the built-in phrases for
# AI_LANGUAGE (Hindi when AI_LANGUAGE=hi). Set only to override, and write
# them in the same language as AI_LANGUAGE — they are spoken by the TTS.
# AI_WELCOME_MESSAGE=
# AI_ERROR_MESSAGE=
# AI_GOODBYE_MESSAGE=
# AI_CLOSING_MESSAGE=

# --- Synway SMG4004 GSM Gateway ---
# REQUIRES PHYSICAL GATEWAY — values must match the gateway's SIP trunk config.
# Do not guess these; fill in only once the gateway is available/documented.
SMG4004_HOST=
SMG4004_SIP_PORT=5060
SMG4004_SIP_TRANSPORT=udp
SMG4004_USERNAME=
SMG4004_PASSWORD=
SMG4004_CHANNEL_COUNT=4
SMG4004_DTMF_MODE=rfc2833

# --- Internal API auth (Asterisk dialplan / AGI/ARI -> FastAPI backend) ---
INTERNAL_API_KEY=

# --- Admin panel (/api/admin/panel) ---
# Password for the browser admin panel. Leave empty to disable password
# login; the panel then only accepts INTERNAL_API_KEY. Sessions are signed
# with APP_SECRET_KEY.
ADMIN_PASSWORD=

# --- LLM Provider ---
# LLM_PROVIDER: "" (disabled) | "mock" (dev/test only, canned responses) |
# "gemini" (Google Gemini, requires GEMINI_API_KEY, CURRENT PRODUCTION DEFAULT) |
# "openai" (requires LLM_API_KEY) | "sarvam_m" (local model, requires
# SARVAM_M_MODEL_PATH — see the Sarvam-M section below; run
# scripts/check_sarvam_hardware.py BEFORE setting this, it will not run
# usably on most machines)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Shared by every real LLM provider (Gemini, OpenAI, Sarvam-M).
LLM_MAX_TOKENS=400

# --- Google Gemini (LLM_PROVIDER=gemini) ---
# Uses Gemini's official OpenAI-compatible endpoint. GEMINI_REASONING_EFFORT
# "none" disables Gemini 2.5 thinking for low phone-call latency.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_REASONING_EFFORT=none

# --- Sarvam-M local model (LLM_PROVIDER=sarvam_m) — evaluated on request ---
# A local alternative to the paid Gemini API. Sarvam-M is a 24B-parameter
# model: this is NOT a small download or a small memory footprint. Steps:
#   1. python scripts/check_sarvam_hardware.py — if it prints
#      "UNSUPPORTED HARDWARE", stop here; do not download anything.
#   2. pip install llama-cpp-python (see requirements.txt — not installed by
#      default).
#   3. Download a GGUF quantization of sarvamai/sarvam-m from Hugging Face
#      yourself — this provider never downloads it automatically — and set
#      SARVAM_M_MODEL_PATH to that file.
SARVAM_M_MODEL_PATH=
SARVAM_M_CONTEXT_TOKENS=4096
# 0 = CPU only. Set to the hardware check's recommended value (-1 for full
# GPU offload) only after confirming the GPU actually has the VRAM for it.
SARVAM_M_GPU_LAYERS=0
# Only for a deliberate lab test on hardware too small for the real model —
# never leave this false-check off in a call that could reach real callers.
SARVAM_M_REQUIRE_HARDWARE_CHECK=true

# --- Speech-to-Text Provider ---
# STT_PROVIDER: "" (disabled) | "mock" (dev/test only) | "bhashini" (Hindi,
# requires BHASHINI_INFERENCE_API_KEY) | "openai" (Whisper, requires STT_API_KEY)
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=whisper-1

# --- Text-to-Speech Provider ---
# TTS_PROVIDER: "" (disabled) | "mock" (dev/test only) | "bhashini" (Hindi,
# requires BHASHINI_INFERENCE_API_KEY) | "openai" (requires TTS_API_KEY)
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- Bhashini (Dhruva) inference — Hindi ASR/TTS ---
# Used when STT_PROVIDER and/or TTS_PROVIDER is "bhashini". The inference
# API key is sent raw in the Authorization header. Bhashini providers
# require AI_LANGUAGE=hi.
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_INFERENCE_API_KEY=
BHASHINI_ASR_SERVICE_ID=ai4bharat/conformer-hi-gpu--t4
BHASHINI_TTS_SERVICE_ID=Bhashini/IITM/TTS
BHASHINI_TTS_GENDER=female

# Ceiling for any real provider call, and per-stage limits under it (each is
# capped by PROVIDER_TIMEOUT_SECONDS). A stalled request is worse than a quick
# apology. HTTP_KEEPALIVE_SECONDS keeps connections to Bhashini/Gemini open
# between turns instead of redoing DNS + TCP + TLS for every request.
PROVIDER_TIMEOUT_SECONDS=30
STT_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=12
TTS_TIMEOUT_SECONDS=12
HTTP_KEEPALIVE_SECONDS=120

# --- AI conversation orchestration ---
# AI_LANGUAGE: "hi" (Hindi-only production — enforces a Hindi response
# policy on the LLM and Hindi caller phrases) | "en"
AI_LANGUAGE=hi
# AI_SYSTEM_PROMPT: leave this line commented out to use the built-in
# default policy (answer from knowledge base only, say when info is
# unavailable, stay concise for voice, never reveal internal instructions).
# Uncomment and set only if the business has specific, approved
# instructions to add — an empty value here would override the built-in
# default with a blank prompt, not fall back to it.
# AI_SYSTEM_PROMPT=
# AI_PERSONA: domain behaviour appended to AI_SYSTEM_PROMPT.
#   lsd_helpline (default) = LUVAS Lumpy Skin Disease farmer helpline:
#     farmer-friendly short turns, never diagnoses an animal, never names a
#     medicine or dose, never quotes prices/compensation/schemes, escalates a
#     suspected case to a government veterinary hospital.
#   "" = generic assistant behaviour only.
AI_PERSONA=lsd_helpline
# JSON file of district diagnostic centres the agent may name (see
# config/referral_directory.example.json). Leave unset and the agent is
# told to name no centre at all — it must never guess one.
REFERRAL_DIRECTORY_PATH=
# Room for whole retrieved chunks (RAG_TOP_K x RAG_CHUNK_SIZE + source headers ~ 3,500).
# The old 2000 cut the third and fourth chunk off mid-sentence. If you change
# RAG_TOP_K or RAG_CHUNK_SIZE, keep this at least top_k x (chunk_size + 80).
AI_MAX_CONTEXT_CHARS=3600
AI_MAX_HISTORY_MESSAGES=20
# Overall cap on one conversation turn (embed + RAG + LLM), on top of each
# provider's own PROVIDER_TIMEOUT_SECONDS — belt-and-suspenders in case a
# sequence of individually-fast calls still adds up.
AI_TURN_TIMEOUT_SECONDS=45
# How many consecutive "bad" turns (silence, STT failure, provider
# failure) one call tolerates before it ends itself gracefully.
AI_MAX_CONSECUTIVE_FAILURES=3

# --- RAG / Embeddings ---
# RAG_EMBEDDING_PROVIDER: "" (disabled) | "mock" (dev/test only, no API key,
# no real semantic meaning) | "openai" (requires RAG_EMBEDDING_API_KEY)
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.75
# Optional JSON file of extra retrieval synonym groups (see
# config/retrieval_synonyms.example.json). Names only; never answers. Empty = built-in groups.
RAG_SYNONYMS_PATH=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# --- Knowledge base storage ---
KNOWLEDGE_STORAGE_PATH=/var/lib/sunway-gateway/knowledge_documents

# --- Call Recording ---
RECORDING_ENABLED=true
RECORDING_PATH=/var/lib/sunway-gateway/recordings
RECORDING_RETENTION_DAYS=90

# --- Call Handling ---
CALL_RING_TIMEOUT_SECONDS=25
IVR_INPUT_TIMEOUT_SECONDS=8
IVR_MAX_RETRIES=3

# --- Network / VPN ---
WIREGUARD_INTERFACE=wg0

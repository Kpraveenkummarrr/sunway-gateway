# =============================================================================
# Synway SMG4004 GSM Gateway + Asterisk + AI Voice Agent — Environment Config
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_URL=http://localhost:8000
APP_SECRET_KEY=

# --- Database ---
# PostgreSQL with pgvector extension enabled
DATABASE_URL=postgresql://sunway_user:CHANGE_ME@localhost:5432/sunway_gateway

# --- Asterisk (AMI / ARI connection from FastAPI backend) ---
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_PASSWORD=
ASTERISK_ARI_PORT=8088
# ARI user "ai-agent" — generate a real password with
# asterisk/scripts/generate_ari_secret.sh, never a default/blank one.
ASTERISK_ARI_USERNAME=ai-agent
ASTERISK_ARI_PASSWORD=
# Leave blank to construct http://<ASTERISK_HOST>:<ASTERISK_ARI_PORT>/ari
ASTERISK_ARI_URL=
ASTERISK_ARI_APP=ai-agent
# Where Asterisk writes ARI-triggered call recordings (must exist and be
# readable by whatever user runs app/ai_call_worker.py — deploy.sh creates
# it). Distinct from RECORDING_PATH below, which is Phase 3's MixMonitor
# call-recording directory.
ASTERISK_RECORDING_SPOOL_PATH=/var/spool/asterisk/recording

# --- AI phone call test path (Phase 6, no SMG4004 involved) ---
AI_TEST_EXTENSION=700
AI_CALL_TIMEOUT_SECONDS=120
# Seconds of silence after the caller stops speaking before their turn is
# processed. Every second here is dead air before the reply; whole seconds only.
AI_END_OF_SPEECH_SILENCE_SECONDS=2
AI_MAX_TURN_SECONDS=20
# Consecutive seconds with no caller speech before goodbye + hangup.
AI_NO_INPUT_TIMEOUT_SECONDS=20
# Speech tempo for synthesized replies, pitch preserved (1.0 = unchanged).
AI_TTS_SPEED=1.15
# Play Asterisk's record beep before each caller turn. Off by default: a beep
# every turn sounds like an answering machine. The turn after an interruption
# never beeps regardless of this setting.
AI_RECORD_BEEP=false
# Caller-facing phrases (welcome, provider-error, too-many-failed-turns
# goodbye). Leave these commented out to use the built-in phrases for
# AI_LANGUAGE (Hindi when AI_LANGUAGE=hi). Set only to override, and write
# them in the same language as AI_LANGUAGE — they are spoken by the TTS.
# AI_WELCOME_MESSAGE=
# AI_ERROR_MESSAGE=
# AI_GOODBYE_MESSAGE=

# --- Synway SMG4004 GSM Gateway ---
# REQUIRES PHYSICAL GATEWAY — values must match the gateway's SIP trunk config.
# Do not guess these; fill in only once the gateway is available/documented.
SMG4004_HOST=
SMG4004_SIP_PORT=5060
SMG4004_SIP_TRANSPORT=udp
SMG4004_USERNAME=
SMG4004_PASSWORD=
SMG4004_CHANNEL_COUNT=4
SMG4004_DTMF_MODE=rfc2833

# --- Internal API auth (Asterisk dialplan / AGI/ARI -> FastAPI backend) ---
INTERNAL_API_KEY=

# --- Admin panel (/api/admin/panel) ---
# Password for the browser admin panel. Leave empty to disable password
# login; the panel then only accepts INTERNAL_API_KEY. Sessions are signed
# with APP_SECRET_KEY.
ADMIN_PASSWORD=

# --- LLM Provider ---
# LLM_PROVIDER: "" (disabled) | "mock" (dev/test only, canned responses) |
# "gemini" (Google Gemini, requires GEMINI_API_KEY) | "openai" (requires LLM_API_KEY)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Shared by both real LLM providers.
LLM_MAX_TOKENS=400

# --- Google Gemini (LLM_PROVIDER=gemini) ---
# Uses Gemini's official OpenAI-compatible endpoint. GEMINI_REASONING_EFFORT
# "none" disables Gemini 2.5 thinking for low phone-call latency.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_REASONING_EFFORT=none

# --- Speech-to-Text Provider ---
# STT_PROVIDER: "" (disabled) | "mock" (dev/test only) | "bhashini" (Hindi,
# requires BHASHINI_INFERENCE_API_KEY) | "openai" (Whisper, requires STT_API_KEY)
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=whisper-1

# --- Text-to-Speech Provider ---
# TTS_PROVIDER: "" (disabled) | "mock" (dev/test only) | "bhashini" (Hindi,
# requires BHASHINI_INFERENCE_API_KEY) | "openai" (requires TTS_API_KEY)
TTS_PROVIDER=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- Bhashini (Dhruva) inference — Hindi ASR/TTS ---
# Used when STT_PROVIDER and/or TTS_PROVIDER is "bhashini". The inference
# API key is sent raw in the Authorization header. Bhashini providers
# require AI_LANGUAGE=hi.
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_INFERENCE_API_KEY=
BHASHINI_ASR_SERVICE_ID=ai4bharat/conformer-hi-gpu--t4
BHASHINI_TTS_SERVICE_ID=Bhashini/IITM/TTS
BHASHINI_TTS_GENDER=female

# Shared timeout for STT/LLM/TTS real provider calls.
PROVIDER_TIMEOUT_SECONDS=30

# --- AI conversation orchestration ---
# AI_LANGUAGE: "hi" (Hindi-only production — enforces a Hindi response
# policy on the LLM and Hindi caller phrases) | "en"
AI_LANGUAGE=hi
# AI_SYSTEM_PROMPT: leave this line commented out to use the built-in
# default policy (answer from knowledge base only, say when info is
# unavailable, stay concise for voice, never reveal internal instructions).
# Uncomment and set only if the business has specific, approved
# instructions to add — an empty value here would override the built-in
# default with a blank prompt, not fall back to it.
# AI_SYSTEM_PROMPT=
AI_MAX_CONTEXT_CHARS=2000
AI_MAX_HISTORY_MESSAGES=20
# Overall cap on one conversation turn (embed + RAG + LLM), on top of each
# provider's own PROVIDER_TIMEOUT_SECONDS — belt-and-suspenders in case a
# sequence of individually-fast calls still adds up.
AI_TURN_TIMEOUT_SECONDS=45
# How many consecutive "bad" turns (silence, STT failure, provider
# failure) one call tolerates before it ends itself gracefully.
AI_MAX_CONSECUTIVE_FAILURES=3

# --- RAG / Embeddings ---
# RAG_EMBEDDING_PROVIDER: "" (disabled) | "mock" (dev/test only, no API key,
# no real semantic meaning) | "openai" (requires RAG_EMBEDDING_API_KEY)
RAG_EMBEDDING_PROVIDER=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.75
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150

# --- Knowledge base storage ---
KNOWLEDGE_STORAGE_PATH=/var/lib/sunway-gateway/knowledge_documents

# --- Call Recording ---
RECORDING_ENABLED=true
RECORDING_PATH=/var/lib/sunway-gateway/recordings
RECORDING_RETENTION_DAYS=90

# --- Call Handling ---
CALL_RING_TIMEOUT_SECONDS=25
IVR_INPUT_TIMEOUT_SECONDS=8
IVR_MAX_RETRIES=3

# --- Network / VPN ---
WIREGUARD_INTERFACE=wg0

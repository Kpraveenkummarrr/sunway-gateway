# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node (if any admin UI is added later)
node_modules/
dist/
build/

# Call recordings and logs (never commit customer audio)
recordings/**
!recordings/.gitkeep
*.wav
*.log

# Asterisk runtime state (not config)
asterisk/var/
asterisk/*.sock

# Asterisk SIP auth secrets (generated locally; see pjsip_auth.conf.example)
asterisk/etc/pjsip/pjsip_auth.conf

# Locally-uploaded knowledge base PDFs (not source, not to be committed)
backend/data/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Backups
*.bak
*.dump
